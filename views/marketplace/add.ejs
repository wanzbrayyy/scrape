<%- include('../partials/header') %>

<div class="dashboard-wrapper">
    <%- include('../partials/navbar') %>

    <main class="main-content">
        <header class="top-header">
            <div style="display:flex; align-items:center;">
                <button id="sidebarCollapse" class="hamburger"><i class="fa-solid fa-bars"></i></button>
                <div class="breadcrumb">
                    <h2>Jual Produk</h2>
                    <span>Panel Seller</span>
                </div>
            </div>
        </header>

        <div class="content-card" style="max-width: 800px;">
            <div class="card-header">
                Form Produk Digital
            </div>
            <div class="card-body">
                <form action="/marketplace/add" method="POST" enctype="multipart/form-data">
                    <div class="form-group">
                        <label style="color:var(--text-secondary)">Nama Produk</label>
                        <input type="text" name="name" class="form-control" required placeholder="Contoh: Script Premium">
                    </div>

                    <div class="form-group">
                        <label style="color:var(--text-secondary)">Thumbnail</label>
                        <input type="file" name="image" class="form-control" required>
                    </div>

                    <div style="display:flex; gap:15px; margin-top:10px;">
                        <div class="form-group" style="flex:1;">
                            <label style="color:var(--text-secondary)">Harga (IDR)</label>
                            <input type="number" name="price" class="form-control" required placeholder="10000">
                        </div>
                        <div class="form-group" style="flex:1;">
                            <label style="color:var(--text-secondary)">Kategori</label>
                            <select name="category" class="form-control">
                                <option value="script">Script / Source Code</option>
                                <option value="account">Akun Premium</option>
                                <option value="tutorial">E-Course / Tutorial</option>
                                <option value="tools">Tools & Software</option>
                            </select>
                        </div>
                    </div>

                    <div class="form-group" style="margin-top:10px;">
                        <label style="color:var(--text-secondary)">Deskripsi</label>
                        <textarea name="description" class="form-control" rows="5" placeholder="Jelaskan detail produk..."></textarea>
                    </div>

                    <button type="submit" class="btn-primary" style="margin-top:20px;">Posting Produk</button>
                </form>
            </div>
        </div>
    </main>
</div>

<%- include('../partials/footer') %>